{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "backend/**",
          "assets/**",
          "products/**",
          "index.html",
          "quote.html",
          "contact.html",
          "robots.txt",
          "sitemap.xml",
          "README.md",
          "styles.css",
          "script.js"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
