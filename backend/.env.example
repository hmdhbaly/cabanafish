# Copy this file to .env and fill in your values

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: origins allowed to call the API (your frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Email (Gmail example — use an App Password, not your main password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Where admin notification emails come from and go to
DEFAULT_FROM_EMAIL=noreply@cabanafish.com
ADMIN_EMAIL=contact@cabanafish.com
